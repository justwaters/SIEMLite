# Copy to .env and edit. Any server flag can be set as SIEMLITE_<FLAG_NAME>.

# Run a prebuilt release instead of building: then use
#   ./update.sh   (it moves this line to the newest release each time)
# SIEMLITE_IMAGE=ghcr.io/justwaters/siemlite:v0.27

# Run on the internet with a Let's Encrypt certificate (see "Run on the
# internet" in the README): set SIEMLITE_HTTPS_PORT=443 under "Host ports"
# below, then choose Let's Encrypt on the System page, or uncomment these two.
# DNS for the domain must point here, and port 443 must be reachable from the
# internet.
# SIEMLITE_TLS_MODE=letsencrypt
# SIEMLITE_DOMAIN=siem.example.com

# Host address to listen on (empty = every interface).
SIEMLITE_BIND=

# Host ports. For a Let's Encrypt certificate, HTTPS must be 443.
SIEMLITE_HTTPS_PORT=8443
SIEMLITE_SYSLOG_PORT=514
SIEMLITE_SYSLOG_TLS_PORT=6514
# The local port, reachable only from this server (published on 127.0.0.1).
# The admin account signs in here when it is kept to the server.
SIEMLITE_LOCAL_PORT=8444

# Names or IPs clients use to reach this server, so the generated certificate
# matches. Only read when the certificate is first created.
SIEMLITE_TLS_HOSTS=

# Networks allowed to send syslog (default: loopback and private ranges).
SIEMLITE_SYSLOG_ALLOW=

# Days of events to keep (default 730, two years). Set it on the System page
# instead; this is only used until the page saves its own.
# SIEMLITE_RETENTION_DAYS=730

# GeoIP: put .mmdb files in ./geoip and name them here.
SIEMLITE_GEOIP_CITY=
SIEMLITE_GEOIP_ASN=

# Threat intel feeds as name=url, separated by spaces.
SIEMLITE_INTEL_FEED=
# Example:
# SIEMLITE_INTEL_FEED=feodo=https://feodotracker.abuse.ch/downloads/ipblocklist.txt drop=https://www.spamhaus.org/drop/drop.txt

# AI help for writing parsers: set up AI Parsers on the Integrations page, with
# a model on this server or in the cloud (OpenRouter). For a model on this
# server, start Ollama with this line (its address is http://ollama:11434):
# COMPOSE_PROFILES=ai

# Keep sending test logs in the background (the loggen service). Add testlogs
# to COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=testlogs, or ai,testlogs) and set
# the rate in events a second: 1, 10, 100, 1000 and so on. See "Test logs" in
# the README.
# LOGGEN_EPS=10
